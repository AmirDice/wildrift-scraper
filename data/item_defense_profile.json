{
 "_note": "Give every completed item a DEFENSIVE WEIGHT, 0.0 to 1.0.",
 "_bands": {
  "0.0": "pure offense",
  "0.25": "minor sustain or HP",
  "0.5": "meaningful hybrid",
  "0.75": "strong defensive carry",
  "1.0": "dedicated defense"
 },
 "_curatedWhy": {
  "bloodthirster": "Lifesteal plus an overheal shield that survives the fight ending. A genuine hybrid for a carry.",
  "guardian-angel": "A revive is the strongest single defensive effect a carry can hold.",
  "blade-of-the-ruined-king": "Lifesteal is real sustain, but the item's job is killing faster. Counting it as THE defensive slot is how a build with five damage items gets called balanced.",
  "trinity-force": "The health is meaningful secondary durability on the champions that buy it, not incidental.",
  "maw-of-malmortius": "Lifeline plus magic resist.",
  "deaths-dance": "Damage deferral plus the execute heal.",
  "wits-end": "Magic resist that scales into an offensive on-hit.",
  "edge-of-night": "A spell shield is the assassin's defensive slot.",
  "steraks-gage": "A health bar for melee, with no offensive identity of its own.",
  "sundered-sky": "Same shape as Goredrinker: a bruiser item whose health and heal are half of why it is bought.",
  "experimental-hexplate": "Health and haste on a frame that still fights.",
  "goredrinker": "Bruiser health plus omnivamp and a heal on the active; the derivation lands it a band low.",
  "riftmaker": "AP bruiser hybrid: the health and omnivamp are the point, not a rider.",
  "bulwark-of-the-mountain": "175 health is meaningful on a support and nowhere near a dedicated defensive item.",
  "black-mist-scythe": "Gold and ability haste. No defence at all: it is the support's income, not its survivability.",
  "immortal-shieldbow": "Lifeline is a second health bar at the moment it matters."
  ,"mercurial-scimitar": "AD, magic resist, lifesteal and Quicksilver; the ADC answer to hard crowd control, not a generic damage purchase."
  ,"randuins-omen": "Strong anti-crit and armor, but a close-range or anti-basic-attack answer rather than a default ranged-carry slot."
 },
