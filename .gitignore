__pycache__/
*.py[cod]
.venv/
venv/
.env

# Block all scraper-debug images / backup snapshots, but allow the live
# leaderboard CSV — the deployed Streamlit app reads from it directly.
data/*.png
data/*.jpg
data/*.csv.bak
# Analytics exports: regenerate with scripts/export_analytics.py or
# scripts/export_web_analytics.py whenever they are wanted. Committing one
# would pin a snapshot that is stale the next day. The web-analytics exporter
# writes wrtruemeta_web_analytics_*, which the narrower pattern above did not
# match, so its first run left an .xlsx staged for commit.
data/wrtruemeta_*analytics_*.xlsx
!data/winrates.csv
!data/.gitkeep

.vscode/
.idea/

# Dev scratch — screenshots and one-off images used while building the app.
# Real production assets live under static/ (served by Streamlit).
images/

# scraper raw-HTML cache
data/wrf_cache/

# Per-device calibration screenshots. Written while aligning tap coordinates
# for one emulator and meaningless on any other machine; a single check.png is
# 2.7MB. The calibration JSON beside them IS tracked -- the images are not.
coords/*/shots/

# Local scratch: prompt dumps and one-off debug scripts, never committed.
scratch/
.vercel
.env*

# Backup snapshots and pre-patch copies (kept locally, never committed).
*.bak
*.backup.json
*.backup-*.json
*.backup-*.py

# Logs (dev server stdout/stderr, scraper runs).
*.log

# One-off debug dumps written to the repo root while testing.
/hecarim.json
/payload_*.json
/prompt_dump.txt

# staging directory built by scripts/deploy_advisor.py
.advisor-deploy/

# scraper capture sessions (hundreds of MB of frames; manifest-driven, local only).
# One pattern per region: data/captures_na/ is not matched by data/captures/.
data/captures/
data/captures_*/
# source screenshots for hand-transcribed champion data (Cho'Gath's release
# tooltips); the transcription is committed, the photos are not
data/chogath/
# navigator debug dumps -- rejected frames; pinned test fixtures are force-added
data/debug_scans/
