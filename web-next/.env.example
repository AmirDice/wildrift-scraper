# Stripe Plus subscription (server-side values; never expose the secret key).
# Prefer a restricted key (rk_test_...) with only the permissions this app needs.
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_PLUS_MONTHLY_PRICE_ID=price_replace_me
STRIPE_PLUS_YEARLY_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional when the canonical URL is different from production.
NEXT_PUBLIC_SITE_URL=https://wrtruemeta.com
